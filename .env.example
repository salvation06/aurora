# Aurora Environment Variables

# Server Configuration
NODE_ENV=production
PORT=3001

# NFT Integration - Pinata IPFS
# Get your Pinata JWT from https://pinata.cloud/
PINATA_JWT=your_pinata_jwt_token_here

# Polkadot Network (testnet or mainnet)
POLKADOT_NETWORK=westend
# Options: westend (testnet) or polkadot (mainnet)

# CORS Configuration (if needed)
# CORS_ORIGIN=https://yourdomain.com
